+/* Adapted from Vuqar05, Madeira PR #622 (commit 3adceb5), LGPL-2.1-or-later.
+ * The kernel reports a hole below min_address but refuses all mappings in it.
+ * Cache once under virtual_mutex, with old behavior on query failure/opt-out.
+ * Unlike a region query, this boundary describes addresses that cannot map.
+ */
+static uintptr_t ios_va_map_floor(void)
+{
+    static uintptr_t floor;
+    static int initialized;
+    if (!initialized)
+    {
+        const char *e = getenv( "MADEIRA_VA_SCAN_FLOOR" );
+        task_vm_info_data_t vmi = {0};
+        mach_msg_type_number_t cnt = TASK_VM_INFO_COUNT;
+        if (!(e && !strcmp(e, "0")) &&
+            task_info( mach_task_self(), TASK_VM_INFO, (task_info_t)&vmi, &cnt ) == KERN_SUCCESS &&
+            vmi.min_address < vmi.max_address)
+            floor = (uintptr_t)vmi.min_address;
+        initialized = 1;
+        dprintf( 2, "[va-scan] floor=%p (MADEIRA_VA_SCAN_FLOOR=0 restores old scans)\n", (void *)floor );
+    }
+    return floor;
+}
+
+/* Returns 0=unchanged, 1=jump upward, 2=scan exhausted. Called only for a
+ * candidate already in the scan window. Division/remainders avoid ceil-add
+ * and step-negation overflow; a jump is formed only if it still fits.
+ * Logical refused attempts retain the old diagnostic/pressure-latch behavior.
+ * The input lattice is preserved even if a caller supplies an unaligned start.
+ */
+static int ios_va_skip_floor( uintptr_t base, uintptr_t end, ptrdiff_t step,
+                              uintptr_t *start, size_t size, uintptr_t floor )
+{
+    uintptr_t a = *start, g, distance, count, up = 0, fit = 0;
+    if (!step || !floor || a >= floor) return 0;
+    if (a < base || a > end || size > end - a) return 0;
+    g = step < 0 ? (uintptr_t)0 - (uintptr_t)step : (uintptr_t)step;
+    if (step < 0)
+    {
+        count = (a - base) / g + 1;
+    }
+    else
+    {
+        distance = floor - a;
+        up = distance / g + (distance % g != 0);
+        /* a is nonzero in the caller, so inclusive fit cannot wrap. */
+        fit = (end - size - a) / g + 1;
+        count = up < fit ? up : fit;
+    }
+    ios_va_scan_tries += (unsigned int)count;
+    ios_va_scan_below_floor += (unsigned int)count;
+    if (!ios_scan_fail_addr) { ios_scan_fail_addr = (void *)a; ios_scan_fail_errno = ENOMEM; }
+    errno = ENOMEM;
+    if (step < 0 || up >= fit) return 2;
+    *start = a + up * g; /* bounded by end-size because up < fit */
+    return 1;
+}
