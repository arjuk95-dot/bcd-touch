         BCDGraphicsDefaults.applyD3D9X64(for: self)
+        // Diagnostic candidate only; never persist or inherit this choice across games.
+        let queenNavCandidate = Bundle.main.object(forInfoDictionaryKey: "BCDQueenNativeNav") as? Bool == true
+        let queenExecutable = (launchRelativePath.replacingOccurrences(of: "\\", with: "/") as NSString).lastPathComponent.lowercased()
+        let useQueenNav = queenNavCandidate && queenExecutable == "queensdomain-win64-shipping.exe"
