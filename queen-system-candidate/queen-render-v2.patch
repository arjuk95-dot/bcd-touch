@@ -0,0 +1,15 @@
+#pragma once
+#include <cstdlib>
+#include "airconv_public.h"
+namespace dxmt {
+inline bool QueenGeometryPayloadEnabled() {
+  static const bool on = [] {
+    const char *v = std::getenv("BCD_QUEEN_GS_PAYLOAD");
+    return v && v[0] == '1' && !v[1];
+  }();
+  return on;
+}
+inline uint32_t QueenGeometryPayloadBytes(uint32_t registers) {
+  return QueenGeometryPayloadEnabled() ? SM50GeometryPayloadByteSize(registers) : 0;
+}
+} // namespace dxmt
