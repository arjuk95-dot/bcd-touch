+/* Optional, versioned by the caller's shader variant key. Old callers do
+ * not chain this record and retain the original16256-byte payload. */
+struct SM50_SHADER_GEOMETRY_PAYLOAD_DATA {
+  void *next;
+  enum SM50_SHADER_COMPILATION_ARGUMENT_TYPE type;
+  uint32_t bytes;
+};
+
+/* Physical layout is int4 header +32 lanes of VS output int4 registers.
+ * NumOutputElement is highest written output register index+1, NOT semantic
+ * count. Keep all holes and builtin registers, and never alter array stride.
+ * The old lowering reserves16256B; unknown/out-of-range widths remain stock.
+ */
+static inline uint32_t SM50GeometryPayloadByteSize(uint32_t registers) {
+  return registers <= 31 ? 16u + 32u * 16u * registers : 16256u;
+}
 
