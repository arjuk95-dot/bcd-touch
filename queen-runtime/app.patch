+// Uses the existing native Present ring: no new work on the per-frame path.
+// This measures frame intervals and CPU/thermal context, not per-function or GPU self-time.
+@MainActor final class QueenRuntimeCapture {
+    static let shared = QueenRuntimeCapture()
+    private var timer: Timer?
+    private var reader = bcd_frame_reader()
+    private var buffer = [UInt64](repeating: 0, count: 512)
+    private var lastFrame: Double?
+    private var firstPresentAt: Double?
+    private var captureAt: Double?
+    private var cpu: CPUMeter?
+    private var gaps: [Double] = []
+    private var rows: [String] = []
+    private var lost: UInt64 = 0
+    private var entry: LibraryEntry?
+    private var initialCount: UInt64 = 0
+    private var foregroundObserver: NSObjectProtocol?
+    private var invalidated = false
+    private var captureCount: UInt64 = 0
+
+    func begin(_ game: LibraryEntry) {
+        stop(reason: "new-session")
+        guard QueenRuntime.enabled, QueenRuntime.accepts(game) else { return }
+        entry = game
+        initialCount = bcd_frame_ring_count()
+        lastFrame = nil; firstPresentAt = nil; captureAt = nil
+        gaps = []; rows = []; lost = 0; invalidated = false
+        foregroundObserver = NotificationCenter.default.addObserver(
+            forName: UIApplication.willResignActiveNotification, object: nil, queue: .main) { [weak self] _ in
+                MainActor.assumeIsolated {
+                    guard let self else { return }
+                    if self.captureAt != nil { self.invalidated = true }
+                    else { self.firstPresentAt = nil; self.initialCount = bcd_frame_ring_count() }
+                }
+            }
+        let value = Timer(timeInterval: 1, repeats: true) { [weak self] _ in
+            MainActor.assumeIsolated { self?.sample() }
+        }
+        value.tolerance = 0.1
+        RunLoop.main.add(value, forMode: .common)
+        timer = value
+    }
+
+    private func sample() {
+        guard UIApplication.shared.applicationState == .active else { return }
+        let now = bcd_frame_ticks_to_seconds(bcd_frame_now_ticks())
+        if firstPresentAt == nil {
+            guard bcd_frame_ring_count() > initialCount else { return }
+            firstPresentAt = now
+        }
+        guard let firstPresentAt, now - firstPresentAt >= 60 else { return }
+        if captureAt == nil {
+            captureAt = now
+            captureCount = bcd_frame_ring_count()
+            reader = bcd_frame_reader_start()
+            cpu = CPUMeter()
+            _ = cpu?.sample()
+            LogStore.shared.log("[queen-capture] 30-second whole-frame window began after warm-up")
+            return
+        }
+        var newLost: UInt64 = 0
+        repeat {
+            let count = Int(bcd_frame_ring_drain(&reader, &buffer, UInt32(buffer.count), &newLost))
+            lost += newLost
+            for index in 0..<count {
+                let frame = bcd_frame_ticks_to_seconds(buffer[index])
+                if let previous = lastFrame, frame >= previous { gaps.append((frame - previous) * 1000) }
+                lastFrame = frame
+            }
+            if count < buffer.count { break }
+        } while true
+        let reading = cpu?.sample()
+        let process = ProcessInfo.processInfo
+        let elapsed = now - (captureAt ?? now)
+        rows.append(String(format: "%.3f,%.2f,%.2f,%d,%d",
+            elapsed, reading?.total ?? -1, reading?.top ?? -1,
+            BCDHUDLive.thermalLevel(process.thermalState), process.isLowPowerModeEnabled ? 1 : 0))
+        if elapsed >= 30 { stop(reason: "complete") }
+    }
+
+    func stop(reason: String) {
+        timer?.invalidate(); timer = nil
+        if let observer = foregroundObserver { NotificationCenter.default.removeObserver(observer) }
+        foregroundObserver = nil
+        defer { entry = nil; captureAt = nil; cpu = nil }
+        guard let game = entry, let start = captureAt, let documents = MadeiraConfig.documents else { return }
+        let sorted = gaps.sorted()
+        func percentile(_ p: Double) -> Double? {
+            guard !sorted.isEmpty else { return nil }
+            return sorted[min(sorted.count - 1, max(0, Int(ceil(p * Double(sorted.count))) - 1))]
+        }
+        let directory = documents.appendingPathComponent("logs/queen-runtime", isDirectory: true)
+        let stamp = UUID().uuidString
+        let elapsed = bcd_frame_ticks_to_seconds(bcd_frame_now_ticks()) - start
+        var report: [String: Any] = [
+            "schema":1, "reason":reason, "seconds":elapsed, "frame_intervals":gaps.count,
+            "lost_ring_entries":lost, "resolution":game.resolution, "fps_mode":game.fpsMode, "frame_generation":false,
+            "foreground_interrupted":invalidated, "build":BuildStamp.text,
+            "lane":UserDefaults.standard.bool(forKey:"queen.runtime.nativeRender") ? "native-render" : "reference-659",
+            "valid_complete_window":reason == "complete" && !invalidated && lost == 0 && !gaps.isEmpty,
+            "metric":"native Present intervals; GPU command-buffer wall time is dependency-inclusive"
+        ]
+        if let median = percentile(0.5) { report["median_ms"] = median }
+        if let p95 = percentile(0.95) { report["p95_ms"] = p95 }
+        if let maximum = sorted.last { report["max_ms"] = maximum }
+        report["real_fps"] = Double(bcd_frame_ring_count() &- captureCount) / max(elapsed, 0.001)
+        if let lastFrame { report["trailing_silence_ms"] = max(0, bcd_frame_ticks_to_seconds(bcd_frame_now_ticks()) - lastFrame) * 1000 }
+        do {
+            try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+            let data = try JSONSerialization.data(withJSONObject: report, options: [.prettyPrinted, .sortedKeys])
+            try data.write(to: directory.appendingPathComponent(stamp + ".json"), options: .atomic)
+            let context = "seconds,cpu_percent_all_cores,top_thread_percent,thermal,low_power\n" + rows.joined(separator:"\n") + "\n"
+            try Data(context.utf8).write(to: directory.appendingPathComponent(stamp + ".csv"), options: .atomic)
+            let raw = "frame_ms\n" + gaps.map { String(format:"%.5f", $0) }.joined(separator:"\n") + "\n"
+            try Data(raw.utf8).write(to: directory.appendingPathComponent(stamp + ".frames.csv"), options: .atomic)
+            LogStore.shared.log("[queen-capture] saved \(gaps.count) frame intervals, lost=\(lost), reason=\(reason), background=\(invalidated)")
+        } catch {
+            LogStore.shared.log("[queen-capture] write failed: \(error.localizedDescription)")
+        }
+    }
+}
