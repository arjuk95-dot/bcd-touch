+// Queen-only host integration; existing in-game controls and session engine are retained.
+import Foundation
+import SwiftUI
+import UniformTypeIdentifiers
+
+enum QueenRuntime {
+    static let enabled = Bundle.main.object(forInfoDictionaryKey: "QueenRuntimeOnly") as? Bool == true
+    static let executable = "queensdomain-win64-shipping.exe"
+    static var started = false
+    static var nativeAvailable: Bool {
+        Bundle.main.path(forResource: "xtajit64-queen-nav", ofType: "dll", inDirectory: "arm64ec-windows") != nil
+    }
+    static func accepts(_ entry: LibraryEntry) -> Bool {
+        (entry.launchRelativePath.replacingOccurrences(of: "\\", with: "/") as NSString)
+            .lastPathComponent.lowercased() == executable && entry.desktop != true
+    }
+    static func configure(_ entry: LibraryEntry) {
+        guard enabled, accepts(entry) else { return }
+        let native = nativeAvailable && UserDefaults.standard.bool(forKey: "queen.runtime.nativeRender")
+        let settings = [
+            "QUEEN_RUNTIME_ONLY":"1", "BCD_QUEEN_NATIVE_RHI":native ? "1" : "0",
+            "BCD_QUEEN_NATIVE_GRAPHICS":native ? "1" : "0", "BCD_QUEEN_NATIVE_NAV":"0",
+            "BCD_QUEEN_RENDER_BATCH":"0", "BCD_QUEEN_RENDER_V2":"0", "BCD_QUEEN_GS_PAYLOAD":"0",
+            "MADEIRA_NTDLL_SYNC":"0", "MADEIRA_NTDLL_XSEC":"0", "MADEIRA_FRAMEGEN":"0",
+            "MADEIRA_PROBES":"light", "MADEIRA_LEAN_DIAG":"1", "MADEIRA_QUIET":"1",
+            "MADEIRA_LUM_PROBE":"0", "MADEIRA_FEX_CB_SAMPLE":"0", "BCD_QUEEN_DIAGNOSTICS":"0"
+        ]
+        for (key, value) in settings { setenv(key, value, 1) }
+        LogStore.shared.log("[queen-runtime] lane=\(native ? "native-render" : "reference-659") real-frames=1 batch=0 gs-payload=0 nav=0 sync=stock resolution=\(entry.resolution)")
+    }
+}
+
+struct QueenRuntimeHome: View {
+    let play: (LibraryEntry) -> Void
+    let enableJIT: () -> Void
+    @ObservedObject private var library = LibraryModel.shared
+    @AppStorage("queen.runtime.nativeRender") private var native = false
+    @State private var resolution = "1440x800"
+    @State private var importing = false
+    @State private var setup = false
+    @State private var busy = false
+    @State private var message: String?
+    @State private var hasLaunched = false
+    private var entry: LibraryEntry? { library.entries.first(where: QueenRuntime.accepts) }
+
+    var body: some View {
+        Form {
+            Section {
+                Text("Queen’s Domain").font(.largeTitle.bold())
+                Text("A separate runtime for your own copy of the game.").foregroundStyle(.secondary)
+                Text("Runtime 1 · \(BuildStamp.text)").font(.caption.monospaced())
+            }
+            Section("Play") {
+                if let entry {
+                    Text(entry.title)
+                    Picker("Resolution", selection: $resolution) {
+                        Text("1440 × 800").tag("1440x800")
+                        Text("1168 × 536").tag("1168x536")
+                        Text("960 × 540").tag("960x540")
+                    }
+                    Button("Play Queen’s Domain", systemImage: "play.fill") {
+                        var launch = entry
+                        launch.resolution = resolution
+                        launch.frameGeneration = false
+                        launch.fpsMode = 2
+                        hasLaunched = true
+                        play(launch)
+                    }.disabled(busy)
+                } else {
+                    Text("Copy your Queen game, saves and controls with the transfer tool, or import a game folder.")
+                    Button("Import game folder", systemImage: "folder") { importing = true }.disabled(busy)
+                    Button("Find copied game", systemImage: "arrow.clockwise") { discover() }.disabled(busy)
+                }
+                Button("Setup and controls", systemImage: "gear") { setup = true }
+                if busy { ProgressView("Copying game…") }
+            }
+            Section("Runtime") {
+                Toggle("Native render workload", isOn: $native).disabled(hasLaunched || !QueenRuntime.nativeAvailable)
+                Text("Reference is the default. Native render replaces verified shader-state and resource-commit workloads. Close and reopen the app before changing runtime after playing. Its performance benefit needs a matched device comparison.")
+                    .font(.footnote).foregroundStyle(.secondary)
+            }
+            Section("Measure a scene") {
+                Text("Frame generation is off. A 30-second capture follows 60 seconds of warm-up after the first frame. Repeat the same save, camera and actions at both resolutions.")
+                    .font(.footnote)
+                Text("Measurements stay in Documents/logs/queen-runtime. Nothing uploads automatically.")
+                    .font(.footnote).foregroundStyle(.secondary)
+            }
+            if let error = library.error ?? message { Section { Text(error).foregroundStyle(.secondary) } }
+        }
+        .onAppear { hasLaunched = QueenRuntime.started; discover() }
+        .sheet(isPresented: $setup) {
+            NavigationStack {
+                BCDLiveFrontEnd(play: { game in
+                    guard QueenRuntime.accepts(game) else {
+                        library.error = "This runtime starts Queen’s Domain only."
+                        return
+                    }
+                    setup = false
+                    hasLaunched = true
+                    var launch = game
+                    launch.frameGeneration = false
+                    play(launch)
+                }, enableJIT: enableJIT, startDock: { _, _ in
+                    library.error = "Use the Queen’s Domain Play button in this runtime."
+                })
+                .toolbar { ToolbarItem(placement: .confirmationAction) { Button("Done") { setup = false } } }
+            }
+        }
+        .fileImporter(isPresented: $importing, allowedContentTypes: [.folder]) { result in
+            switch result {
+            case .success(let url): importFolder(url)
+            case .failure(let error): message = error.localizedDescription
+            }
+        }
+    }
+
+    private func discover() {
+        guard entry == nil, let drive = GameLibrary.driveC else { return }
+        guard let found = GameLibrary.scan().first(where: { $0.fileName.lowercased() == QueenRuntime.executable }) else { return }
+        do {
+            guard found.url.path.hasPrefix(drive.path + "/") else { return }
+            var game = try LibraryEntry.inspect(found.url)
+            game.title = "Queen’s Domain"
+            game.resolution = "1440x800"
+            game.touchControls = true
+            game.frameGeneration = false
+            game.fpsMode = 2
+            library.save(game)
+        } catch { message = error.localizedDescription }
+    }
+
+    private func importFolder(_ source: URL) {
+        guard !busy, let drive = GameLibrary.driveC else { return }
+        busy = true
+        DispatchQueue.global(qos: .userInitiated).async {
+            let access = source.startAccessingSecurityScopedResource()
+            defer { if access { source.stopAccessingSecurityScopedResource() } }
+            let fm = FileManager.default
+            let destination = drive.appendingPathComponent("QueenImported", isDirectory: true)
+            let staging = drive.appendingPathComponent(".queen-import-" + UUID().uuidString, isDirectory: true)
+            var failure: String?
+            do {
+                guard !fm.fileExists(atPath: destination.path) else {
+                    throw LibraryError.message("QueenImported already exists. Keep its saves before replacing it in Files.")
+                }
+                try fm.createDirectory(at: drive, withIntermediateDirectories: true)
+                try fm.copyItem(at: source, to: staging)
+                guard let files = fm.enumerator(at: staging, includingPropertiesForKeys: [.isSymbolicLinkKey]) else {
+                    throw LibraryError.message("The copied folder cannot be read.")
+                }
+                var found = false
+                for case let file as URL in files {
+                    if (try file.resourceValues(forKeys: [.isSymbolicLinkKey])).isSymbolicLink == true {
+                        throw LibraryError.message("Import ordinary game files without symbolic links.")
+                    }
+                    if file.lastPathComponent.lowercased() == QueenRuntime.executable { found = true }
+                }
+                guard found else { throw LibraryError.message("The folder does not contain QueensDomain-Win64-Shipping.exe.") }
+                try fm.moveItem(at: staging, to: destination)
+            } catch {
+                failure = error.localizedDescription
+                try? fm.removeItem(at: staging)
+            }
+            DispatchQueue.main.async {
+                busy = false
+                message = failure
+                if failure == nil { discover() }
+            }
+        }
+    }
+}
